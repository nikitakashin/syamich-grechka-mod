<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>GrechkaTreasures_CutAnyGem</defName>
    <label>огранить любые камни</label>
    <description>Ограняет один любой необработанный драгоценный камень в один огранённый камень того же вида. Разрешённые виды можно выбрать в фильтре задания. Монолиты распиливаются отдельными заданиями.</description>
    <jobString>Обрабатывает драгоценный камень.</jobString>
    <workAmount>2400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <researchPrerequisite>GrechkaTreasures_Jewelcraft</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>GrechkaTreasures_DiamondRaw</li>
            <li>GrechkaTreasures_RubyRaw</li>
            <li>GrechkaTreasures_SapphireRaw</li>
            <li>GrechkaTreasures_EmeraldRaw</li>
            <li>GrechkaTreasures_AmethystRaw</li>
            <li>GrechkaTreasures_TopazRaw</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>GrechkaTreasures_DiamondRaw</li>
        <li>GrechkaTreasures_RubyRaw</li>
        <li>GrechkaTreasures_SapphireRaw</li>
        <li>GrechkaTreasures_EmeraldRaw</li>
        <li>GrechkaTreasures_AmethystRaw</li>
        <li>GrechkaTreasures_TopazRaw</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products />
    <recipeUsers>
      <li>GrechkaTreasures_JewelersBench</li>
    </recipeUsers>
    <workerClass>Grechka.Treasures.RecipeWorker_CutAnyGem</workerClass>
  </RecipeDef>
