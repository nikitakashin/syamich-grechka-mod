  <ThingDef ParentName="BuildingBase">
    <defName>GrechkaTreasures_JewelersBench</defName>
    <label>ювелирный верстак</label>
    <description>Ручная огранка драгоценных камней, распил монолитов и изготовление ювелирного оружия и резного декора. Не требует электричества.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/JewelersBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <designationCategory>Grechka_IndustryCategory</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.2</Flammability>
      <WorkTableWorkSpeedFactor>1</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <WoodLog>60</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>GrechkaTreasures_Jewelcraft</li>
    </researchPrerequisites>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
    </comps>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
  </ThingDef>
