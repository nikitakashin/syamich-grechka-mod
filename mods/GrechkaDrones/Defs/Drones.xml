  <ThingDef Class="AIRobot.X2_ThingDef_AIRobot" ParentName="Grechka_DroneBase">
    <defName>Grechka_RescueDroneT1_Unit</defName>
    <label>дрон-МЧСник T1</label>
    <description>Негорючий спасательный дрон. Переносит своих раненых в медицинские кровати и тушит пожары пеной по площади. По переключателю берёт раненых врагов в плен при наличии тюремных мест. Ради спасения своего оставляет переносимого врага.</description>
    <uiIconPath>Drones/Rescue/T1/RescueT1_south</uiIconPath>
    <statBases>
      <MarketValue>500</MarketValue>
      <MoveSpeed>5</MoveSpeed>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
    </statBases>
    <race>
      <baseHealthScale>1</baseHealthScale>
    </race>
    <tools Inherit="False">
      <li>
        <label>ударный манипулятор</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <chanceFactor>1</chanceFactor>
      </li>
    </tools>
    <robotSkills>
      <li>
        <skillDef>Melee</skillDef>
        <level>4</level>
      </li>
    </robotSkills>
    <modExtensions>
      <li Class="Grechka.Drones.DroneProperties">
        <role>Rescue</role>
        <tier>1</tier>
        <foamRadius>3</foamRadius>
        <foamCooldownTicks>300</foamCooldownTicks>
      </li>
    </modExtensions>
  </ThingDef>
