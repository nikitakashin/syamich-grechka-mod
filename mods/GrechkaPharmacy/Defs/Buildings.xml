<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <DesignatorDropdownGroupDef>
    <defName>GrechkaPharmacy_ReactorGroup</defName>
  </DesignatorDropdownGroupDef>
  <ThingDef ParentName="BenchBase">
    <defName>GrechkaPharmacy_ReactorT3_Building</defName>
    <label>pharmaceutical reactor T3</label>
    <description>Produces preparations up to tier 3. Requires a worker and power. Work speed x5.</description>
    <thingClass>Building_WorkTable</thingClass>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <size>(3,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <graphicData>
      <texPath>Buildings/PharmaReactorT3</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <designationCategory>Grechka_IndustryCategory</designationCategory>
    <designatorDropdown>GrechkaPharmacy_ReactorGroup</designatorDropdown>
    <uiOrder>2753</uiOrder>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>12000</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <WorkTableWorkSpeedFactor>5</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <Plasteel>30</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <workTableNotInRoomRoleFactor>1</workTableNotInRoomRoleFactor>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>GrechkaPharmacy_ResearchT3</li>
    </researchPrerequisites>
  </ThingDef>
