    <defName>GrechkaPharmacy_HemostaticEffect</defName>
    <label>hemostatic dressing</label>
    <description>Hemostatic dressing. See the preparation for its effect and duration.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500~7500</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <totalBleedFactor>0.15</totalBleedFactor>
