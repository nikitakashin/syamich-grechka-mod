        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>GrechkaTreasures_TopazCut</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>GrechkaTreasures_SapphireCut</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
