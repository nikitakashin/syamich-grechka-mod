    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
        <li>Neutroamine</li>
        <li>GrechkaTreasures_TopazCut</li>
        <li>GrechkaTreasures_SapphireCut</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GrechkaPharmacy_TrainerInterest_Item>1</GrechkaPharmacy_TrainerInterest_Item>
    </products>
    <skillRequirements>
      <Intellectual>8</Intellectual>
