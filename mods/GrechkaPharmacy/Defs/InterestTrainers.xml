<Defs>
  <ThingDef ParentName="ResourceBase" MayRequire="grechka.treasures,grechka.tweaks">
    <defName>GrechkaPharmacy_TrainerInterest_Item</defName>
    <label>interest neurotrainer</label>
    <description>A single-use neurotrainer. Permanently gives one interest flame to one randomly chosen enabled skill with no interest. Skill level and experience stay unchanged. Aversions, existing flames and disabled skills are excluded. If no skill qualifies, use is blocked and the trainer is preserved.</description>
    <thingClass>ThingWithComps</thingClass>
    <techLevel>Spacer</techLevel>
    <rotatable>false</rotatable>
    <stackLimit>10</stackLimit>
    <useHitPoints>true</useHitPoints>
    <graphicData>
      <texPath>Items/TrainerInterest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconPath>Items/TrainerInterest</uiIconPath>
    <statBases>
      <MarketValue>1800</MarketValue>
      <Mass>0.2</Mass>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>NeurotrainersSkill</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Use {0_label}</useLabel>
        <useDuration>600</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="Grechka.Tweaks.CompProperties_InterestTrainer">
        <grade>2</grade>
      </li>
    </comps>
  </ThingDef>
  <RecipeDef MayRequire="grechka.treasures,grechka.tweaks">
