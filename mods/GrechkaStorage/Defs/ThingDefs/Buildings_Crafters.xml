<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <DesignatorDropdownGroupDef>
    <defName>Grechka_StorageCrafters</defName>
    <label>крафтер Storage</label>
  </DesignatorDropdownGroupDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_StorageCrafterT3_Building</defName>
    <label>крафтер Storage T3</label>
    <description>Стационарный исполнитель для четырёх соседних станков. Один цикл за раз, по кругу; снабжение из дисков и возврат продукции автоматически. Скорость исполнителя ×1, квалификация 12, мощность 500 Вт.</description>
    <thingClass>Grechka.Storage.Building_StorageCrafter</thingClass>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Rare</tickerType>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <texPath>Buildings/Map/StorageCrafter/StorageCrafter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <Plasteel>20</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <Grechka_GoldProcessor>2</Grechka_GoldProcessor>
      <Grechka_CertusQuartz>10</Grechka_CertusQuartz>
    </costList>
    <comps>
      <li Class="Grechka.Storage.CompProperties_StorageMachineArt">
        <texture>Buildings/Map/States/StorageCrafter/StorageCrafter</texture>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <modExtensions>
      <li Class="Grechka.Storage.CrafterProperties">
        <skill>12</skill>
        <speed>1</speed>
      </li>
    </modExtensions>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Grechka_IndustryCategory</designationCategory>
    <designatorDropdown>Grechka_StorageCrafters</designatorDropdown>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <uiIconPath>Buildings/StorageCrafter</uiIconPath>
  </ThingDef>
