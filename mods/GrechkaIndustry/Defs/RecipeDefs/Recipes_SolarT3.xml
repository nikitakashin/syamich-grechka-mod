<Defs>
  <RecipeDef>
    <defName>Grechka_MakeSolarCellT3</defName>
    <label>собрать механитные фотоэлементы ×4</label>
    <description>Усилить предыдущие фотоэлементы механитами и меха-компонентом.</description>
    <jobString>Собирает фотоэлементы.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>18000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_SolarCellT2_Item</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_Mechanites</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_ComponentT3_Item</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Grechka_SolarCellT2_Item</li>
        <li>Grechka_Mechanites</li>
        <li>Grechka_ComponentT3_Item</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Grechka_SolarCellT3_Item>8</Grechka_SolarCellT3_Item>
    </products>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>
