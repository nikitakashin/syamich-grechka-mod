<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>Grechka_MakeComponentByHandT1</defName>
    <label>собрать компонент вручную</label>
    <description>Медленно собрать один обычный компонент из 12 стали на ремесленном месте.</description>
    <jobString>Собирает компонент вручную.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>10000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <ingredients><li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>12</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li></thingDefs></fixedIngredientFilter>
    <products><ComponentIndustrial>1</ComponentIndustrial></products>
    <workSkill>Crafting</workSkill>
    <skillRequirements><Crafting>3</Crafting></skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>Grechka_MakeHousingT1</defName>
    <label>собрать базовый корпус</label>
    <description>Собрать светло-серый корпус T1 из стали и обычных компонентов.</description>
    <jobString>Собирает базовый корпус.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>12000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>80</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>4</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><Grechka_HousingT1_Item>1</Grechka_HousingT1_Item></products>
    <workSkill>Crafting</workSkill>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>Grechka_MakeComponentBatchT1</defName>
    <label>собрать компоненты серией ×5</label>
    <description>На базовом сборочном верстаке превратить 60 стали в пять обычных компонентов.</description>
    <jobString>Собирает серию компонентов.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>20000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <ingredients><li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>60</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li></thingDefs></fixedIngredientFilter>
    <products><ComponentIndustrial>5</ComponentIndustrial></products>
    <workSkill>Crafting</workSkill>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>Grechka_MakeHousingT2</defName>
    <label>собрать продвинутый корпус</label>
    <description>Собрать тёмно-серый корпус T2 на базовом сборочном верстаке.</description>
    <jobString>Собирает продвинутый корпус.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>20000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Grechka_HousingT1_Item</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>4</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>Grechka_HousingT1_Item</li><li>Steel</li><li>Plasteel</li><li>ComponentSpacer</li></thingDefs>
    </fixedIngredientFilter>
    <products><Grechka_HousingT2_Item>1</Grechka_HousingT2_Item></products>
    <workSkill>Crafting</workSkill>
    <skillRequirements><Crafting>6</Crafting></skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>Grechka_UpgradeAssemblyBenchT2</defName>
    <label>улучшить сборочный верстак до T2</label>
    <description>Улучшить этот верстак на месте. Уже установленный корпус T1 используется повторно; нужны материалы корпуса T2 и остальная стоимость нового верстака.</description>
    <jobString>Улучшает сборочный верстак до T2.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>4000</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>120</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>6</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>Steel</li><li>Plasteel</li><li>ComponentIndustrial</li><li>ComponentSpacer</li></thingDefs>
    </fixedIngredientFilter>
    <workSkill>Crafting</workSkill>
    <skillRequirements><Crafting>6</Crafting></skillRequirements>
  </RecipeDef>
</Defs>
