<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_SolarS5_Building</defName>
    <label>архо-солнечная панель</label>
    <description>Солнечная ступень S5: 4,608,000 Вт. Ночью сохраняет 25% мощности.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/Solar/Main/SolarS5_Archo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData>
        <volume>(3.5,0.75,3.4)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
      <damageData>
        <rect>(0,0.6,4,2.8)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <minifiedDef>Grechka_PackedSolarS5_Item</minifiedDef>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Mass>140</Mass>
      <WorkToBuild>16000</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Grechka.Industry.CompPowerPlantLateSolar</compClass>
        <basePowerConsumption>-4608000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <empChancePerTick>0.03</empChancePerTick>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
      <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
        <targetDefName>Grechka_SolarS6_Building</targetDefName>
        <costDescription>предыдущее устройство целиком и дополнительные материалы следующей ступени; установленный корпус уже учтён</costDescription>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <designationCategory>Grechka_SolarCategory</designationCategory>
    <uiOrder>140</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList>
      <Grechka_PackedSolarS4_Item>1</Grechka_PackedSolarS4_Item>
      <Grechka_ComponentT4_Item>2</Grechka_ComponentT4_Item>
      <Grechka_SolarCellT4_Item>24</Grechka_SolarCellT4_Item>
      <Plasteel>30</Plasteel>
      <Grechka_ArchoSubstrate>10</Grechka_ArchoSubstrate>
    </costList>
    <modExtensions>
      <li Class="Grechka.Industry.LateSolarProperties">
        <nightFraction>0.25</nightFraction>
      </li>
    </modExtensions>
  </ThingDef>
