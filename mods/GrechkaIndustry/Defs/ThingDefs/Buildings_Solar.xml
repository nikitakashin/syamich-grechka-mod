<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_SolarS1_Building</defName>
    <label>усиленная солнечная панель</label>
    <description>Следующая ступень после обычной солнечной панели. Производит до 6000 Вт при достаточном солнечном освещении; ночью не работает.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <!-- Временная ванильная графика, пока не подготовлены слои цвета тира. -->
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData><volume>(3.5,0.75,3.4)</volume><offset>(0,0,0)</offset></shadowData>
      <damageData><rect>(0,0.6,4,2.8)</rect></damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <minifiedDef>Grechka_PackedSolarS1_Item</minifiedDef>
    <statBases>
      <MaxHitPoints>360</MaxHitPoints>
      <Mass>60</Mass>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <building><destroySound>BuildingDestroyed_Metal_Big</destroySound></building>
    <costList>
      <Grechka_PackedSolarS0_Item>1</Grechka_PackedSolarS0_Item>
      <Grechka_HousingT2_Item>1</Grechka_HousingT2_Item>
      <ComponentSpacer>4</ComponentSpacer>
      <Grechka_SolarCellT2_Item>8</Grechka_SolarCellT2_Item>
    </costList>
    <comps>
      <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
        <targetDefName>Grechka_SolarS2_Building</targetDefName>
        <costDescription>2 снятые панели S1, 1 корпус T2, 8 продвинутых компонентов, 24 фотоэлемента T2 и 20 пластали</costDescription>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlantSolar</compClass>
        <basePowerConsumption>-6000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <empChancePerTick>0.03</empChancePerTick>
        <affectedDamageDefs><li>EMP</li></affectedDamageDefs>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories><li>BuildingsSpecial</li></thingCategories>
    <designationCategory>Power</designationCategory>
    <designatorDropdown>Grechka_SolarPanelGroup</designatorDropdown>
    <uiOrder>2101</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_SolarS2_Building</defName>
    <label>многослойная солнечная панель</label>
    <description>Вторая промышленная ступень солнечной линии. Производит до 18000 Вт при достаточном солнечном освещении; ночью не работает.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <!-- Временная ванильная графика до текстуры S2. -->
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData><volume>(3.5,0.75,3.4)</volume><offset>(0,0,0)</offset></shadowData>
      <damageData><rect>(0,0.6,4,2.8)</rect></damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <minifiedDef>Grechka_PackedSolarS2_Item</minifiedDef>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <Mass>80</Mass>
      <WorkToBuild>6500</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <building><destroySound>BuildingDestroyed_Metal_Big</destroySound></building>
    <costList>
      <Grechka_PackedSolarS1_Item>2</Grechka_PackedSolarS1_Item>
      <Grechka_HousingT2_Item>1</Grechka_HousingT2_Item>
      <ComponentSpacer>8</ComponentSpacer>
      <Grechka_SolarCellT2_Item>24</Grechka_SolarCellT2_Item>
      <Plasteel>20</Plasteel>
    </costList>
    <comps>
      <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
        <targetDefName>Grechka_SolarS3_Building</targetDefName>
        <costDescription>эта панель S2 и ещё 2 панели S2, 1 корпус T3, 8 меха-компонентов и 16 фотоэлементов T3</costDescription>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlantSolar</compClass>
        <basePowerConsumption>-18000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <empChancePerTick>0.03</empChancePerTick>
        <affectedDamageDefs><li>EMP</li></affectedDamageDefs>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories><li>BuildingsSpecial</li></thingCategories>
    <designationCategory>Power</designationCategory>
    <designatorDropdown>Grechka_SolarPanelGroup</designatorDropdown>
    <uiOrder>2102</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
