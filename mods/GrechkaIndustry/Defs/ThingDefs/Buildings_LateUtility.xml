<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_IonizerT4_Building</defName>
    <label>комнатный ионизатор T4</label>
    <description>Усиленное оборудование T4. Освещает всю закрытую комнату и убирает грязь. Без суммирования одинаковых эффектов.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Buildings/IonizerT3</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.25,1.25)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Rare</tickerType>
    <minifiedDef>Grechka_PackedIonizerT4_Item</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>4500</WorkToBuild>
      <MaxHitPoints>260</MaxHitPoints>
      <Mass>15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3300</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Grechka.Industry.CompProperties_RoomIonizer">
        <cleaningLayersPerCycle>32</cleaningLayersPerCycle>
      </li>
      <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
        <targetDefName>Grechka_IonizerT5_Building</targetDefName>
        <costDescription>установленное устройство, 10 компонентов T5, 160 пластали и 24 концентрата</costDescription>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <designatorDropdown>Grechka_IonizerGroup</designatorDropdown>
    <uiOrder>2522</uiOrder>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <constructEffect>ConstructMetal</constructEffect>
    <costList>
      <Grechka_PackedIonizerT3_Item>1</Grechka_PackedIonizerT3_Item>
      <Grechka_ComponentT4_Item>10</Grechka_ComponentT4_Item>
      <Plasteel>100</Plasteel>
      <Grechka_ArchoSubstrate>8</Grechka_ArchoSubstrate>
    </costList>
  </ThingDef>
