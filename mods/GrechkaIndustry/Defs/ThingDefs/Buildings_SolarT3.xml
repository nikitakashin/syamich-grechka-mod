<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Grechka_SolarS3_Building</defName>
    <label>механитная солнечная панель</label>
    <description>Механитная ступень S3 солнечной линии. Производит до 72 000 Вт при достаточном солнечном освещении; ночью не работает. Переоснащается из одной панели предыдущей ступени; её корпус учитывается.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/Solar/Main/SolarS3_Mechanite</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData>
        <volume>(3.5,0.75,3.4)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
      <damageData>
        <rect>(0,0.6,4,2.8)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <minifiedDef>Grechka_PackedSolarS3_Item</minifiedDef>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Mass>100</Mass>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Grechka_PackedSolarS2_Item>1</Grechka_PackedSolarS2_Item>
      <Grechka_ComponentT3_Item>2</Grechka_ComponentT3_Item>
      <Grechka_SolarCellT3_Item>16</Grechka_SolarCellT3_Item>
      <Plasteel>20</Plasteel>
      <Grechka_Mechanites>10</Grechka_Mechanites>
    </costList>
    <comps>
      <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
        <targetDefName>Grechka_SolarS4_Building</targetDefName>
        <costDescription>предыдущее устройство целиком и дополнительные материалы следующей ступени; установленный корпус уже учтён</costDescription>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlantSolar</compClass>
        <basePowerConsumption>-72000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <empChancePerTick>0.03</empChancePerTick>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <designationCategory>Grechka_SolarCategory</designationCategory>
    <uiOrder>40</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
  </ThingDef>
