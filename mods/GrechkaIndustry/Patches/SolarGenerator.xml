    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]</xpath>
        <value>
          <minifiedDef>Grechka_PackedSolarS0_Item</minifiedDef>
          <designatorDropdown>Grechka_SolarPanelGroup</designatorDropdown>
          <thingCategories><li>BuildingsSpecial</li></thingCategories>
