<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]</xpath>
        <value>
          <minifiedDef>Grechka_PackedSolarS0_Item</minifiedDef>
          <thingCategories><li>BuildingsSpecial</li></thingCategories>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]/statBases</xpath>
        <value><Mass>50</Mass></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]/comps</xpath>
        <value>
          <li Class="Grechka.Industry.CompProperties_SolarUpgrade">
            <targetDefName>Grechka_SolarS1_Building</targetDefName>
            <costDescription>1 снятая ванильная панель, 1 корпус T2, 4 продвинутых компонента и 8 фотоэлементов T2</costDescription>
          </li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]/designationCategory</xpath>
        <value><designationCategory>Grechka_SolarCategory</designationCategory></value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]/designatorDropdown</xpath>
        <match Class="PatchOperationRemove">
          <xpath>/Defs/ThingDef[defName="SolarGenerator"]/designatorDropdown</xpath>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="SolarGenerator"]/uiOrder</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="SolarGenerator"]/uiOrder</xpath>
          <value><uiOrder>0</uiOrder></value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="SolarGenerator"]</xpath>
          <value><uiOrder>0</uiOrder></value>
        </nomatch>
      </li>
    </operations>
  </Operation>
</Patch>
