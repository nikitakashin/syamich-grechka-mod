<Defs>
  <RecipeDef>
    <defName>Grechka_UpgradeArmorT4</defName>
    <label>улучшить броню до T4</label>
    <description>Предыдущий комплект расходуется. Пласталь и синтеткань корпуса засчитываются; нужны только компоненты и материал новой ступени. Качество результата определяется обычной работой мастера.</description>
    <jobString>Улучшение оснащения.</jobString>
    <workAmount>30000</workAmount>
    <workSkill>Crafting</workSkill>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_ArmorT3_Item</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_ComponentT4_Item</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Grechka_ArchoSubstrate</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Grechka_ArmorT3_Item</li>
        <li>Grechka_ComponentT4_Item</li>
        <li>Grechka_ArchoSubstrate</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Grechka_ArmorT4_Item>1</Grechka_ArmorT4_Item>
    </products>
    <recipeUsers>
      <li>FabricationBench</li>
      <li>Grechka_AssemblyBenchT4_Building</li>
    </recipeUsers>
  </RecipeDef>
